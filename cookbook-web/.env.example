# ========== LLM 設定 ==========
# 格式：openai 或 anthropic
LLM_FORMAT=openai

# 地端 LLM endpoint（不含 /chat/completions 或 /messages 後綴）
# 範例：
#   Ollama:           http://host.docker.internal:11434/v1
#   vLLM (OpenAI 相容): http://internal-llm.corp:8000/v1
#   Anthropic 相容:    http://internal-claude.corp:8080/v1
LLM_ENDPOINT=http://host.docker.internal:11434/v1

# API key；若 endpoint 不需要驗證，可保留為任意字串
LLM_API_KEY=no-key

# 模型名稱（傳給 LLM endpoint 的 model 欄位）
LLM_MODEL=llama3

# 串流逾時（秒）
LLM_TIMEOUT_SECONDS=120
